# Copy to .env and fill in. Nothing here is read by the website; only the engine reads it.
CBJ_PLANNER=claude                 # your Claude account through the Claude Code CLI (run `claude` once to log in); no API key
GEMINI_API_KEY=                    # reads reference videos (https://aistudio.google.com/apikey)
NVIDIA_API_KEY=                    # optional: the fallback reader (Nemotron, open weights on build.nvidia.com) and the spoken hook
TAVILY_API_KEY=                    # optional: ideas from trends
# CBJ_API_TOKEN=                   # optional: protects the engine's /api when it is exposed (the site sends it as a Bearer token)
# CBJ_CORS_ORIGINS=https://cbj-creative-studio.vercel.app   # let the hosted site call this engine directly (Your engine)
# R2_ACCOUNT_ID= R2_ACCESS_KEY_ID= R2_SECRET_ACCESS_KEY=    # optional: scripts/r2_publish.py (the catalogue on Cloudflare R2)
